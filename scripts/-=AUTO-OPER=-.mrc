on *:DIALOG:autooper:edit:*: {
  if ($did == 1) { set %ircop.serv1 $did(1) }
  if ($did == 4) { set %ircop.nick1 $did(4) }
  if ($did == 7) { set %ircop.pass1 $did(7).text }
  if ($did == 2) { set %ircop.serv2 $did(2) }
  if ($did == 5) { set %ircop.nick2 $did(5) }
  if ($did == 8) { set %ircop.pass2 $did(8).text }
  if ($did == 3) { set %ircop.serv3 $did(3) }
  if ($did == 6) { set %ircop.nick3 $did(6) }
  if ($did == 9) { set %ircop.pass3 $did(9).text }
  if ($did == 41) { set %ircop.serv4 $did(41) }
  if ($did == 71) { set %ircop.nick4 $did(71) }
  if ($did == 101) { set %ircop.pass4 $did(101).text }
  if ($did == 42) { set %ircop.serv5 $did(42) }
  if ($did == 72) { set %ircop.nick5 $did(72) }
  if ($did == 102) { set %ircop.pass5 $did(102).text }
  if ($did == 43) { set %ircop.serv6 $did(43) }
  if ($did == 73) { set %ircop.nick6 $did(73) }
  if ($did == 103) { set %ircop.pass6 $did(103).text }
  if ($did == 44) { set %ircop.serv7 $did(44) }
  if ($did == 74) { set %ircop.nick7 $did(74) }
  if ($did == 104) { set %ircop.pass7 $did(104).text }
  if ($did == 45) { set %ircop.serv8 $did(45) }
  if ($did == 75) { set %ircop.nick8 $did(75) }
  if ($did == 105) { set %ircop.pass8 $did(105).text }
  if ($did == 46) { set %ircop.serv9 $did(46) }
  if ($did == 76) { set %ircop.nick9 $did(76) }
  if ($did == 106) { set %ircop.pass9 $did(106).text }
  if ($did == 47) { set %ircop.serv10 $did(47) }
  if ($did == 77) { set %ircop.nick10 $did(77) }
  if ($did == 107) { set %ircop.pass10 $did(107).text }
  if ($did == 309) { set %auto-todo1 $did(309) }
  if ($did == 319) { set %auto-todo2 $did(319) }
  if ($did == 329) { set %auto-todo3 $did(329) }
  if ($did == 330) { set %auto-todo4 $did(330) }
}
on *:dialog:autooper:init:0: {
  did -o autooper 1 1 %ircop.serv1 $did(1)
  did -o autooper 2 1 %ircop.serv2 $did(2)
  did -o autooper 3 1 %ircop.serv3 $did(3)
  did -o autooper 41 1 %ircop.serv4 $did(41)
  did -o autooper 42 1 %ircop.serv5 $did(42)
  did -o autooper 43 1 %ircop.serv6 $did(43)
  did -o autooper 44 1 %ircop.serv7 $did(44)
  did -o autooper 45 1 %ircop.serv8 $did(45)
  did -o autooper 46 1 %ircop.serv9 $did(46)
  did -o autooper 47 1 %ircop.serv10 $did(47)
  did -o autooper 4 1 %ircop.nick1 $did(4) 
  did -o autooper 5 1 %ircop.nick2 $did(5) 
  did -o autooper 6 1 %ircop.nick3 $did(6) 
  did -o autooper 71 1 %ircop.nick4 $did(71) 
  did -o autooper 72 1 %ircop.nick5 $did(72) 
  did -o autooper 73 1 %ircop.nick6 $did(73) 
  did -o autooper 74 1 %ircop.nick7 $did(74) 
  did -o autooper 75 1 %ircop.nick8 $did(75) 
  did -o autooper 76 1 %ircop.nick9 $did(76) 
  did -o autooper 77 1 %ircop.nick10 $did(77) 
  did -o autooper 7 1 %ircop.pass1 $did(7).text
  did -o autooper 8 1 %ircop.pass2 $did(8).text
  did -o autooper 9 1 %ircop.pass3 $did(9).text
  did -o autooper 101 1 %ircop.pass4 $did(101).text
  did -o autooper 102 1 %ircop.pass5 $did(102).text
  did -o autooper 103 1 %ircop.pass6 $did(103).text
  did -o autooper 104 1 %ircop.pass7 $did(104).text
  did -o autooper 105 1 %ircop.pass8 $did(105).text
  did -o autooper 106 1 %ircop.pass9 $did(106).text
  did -o autooper 107 1 %ircop.pass10 $did(107).text
  did -o autooper 309 1 %auto-todo1 $did(309)
  did -o autooper 319 1 %auto-todo2 $did(319)
  did -o autooper 329 1 %auto-todo3 $did(329)
  did -o autooper 330 1 %auto-todo4 $did(330)
  if (%auto.oper1 == on) { did -c autooper 13 1 %auto.oper1 $did(13) }
  if (%auto.oper1 == off) { did -c autooper 14 1 %auto.oper1 $did(14) }
  if (%auto.oper1 == off) { did -b $dname 1,4,7 }
  if (%auto.oper1 == on) { did -e $dname 1,4,7 }
  if (%auto.oper2 == on) { did -c autooper 15 1 %auto.oper2 $did(15) }
  if (%auto.oper2 == off) { did -c autooper 16 1 %auto.oper2 $did(16) }
  if (%auto.oper2 == off) { did -b $dname 2,5,8 }
  if (%auto.oper2 == on) { did -e $dname 2,5,8 }
  if (%auto.oper3 == on) { did -c autooper 17 1 %auto.oper3 $did(17) }
  if (%auto.oper3 == off) { did -c autooper 18 1 %auto.oper3 $did(18) }
  if (%auto.oper3 == off) { did -b $dname 3,6,9 }
  if (%auto.oper3 == on) { did -e $dname 3,6,9 }
  if (%auto.oper4 == on) { did -c autooper 19 1 %auto.oper4 $did(19) }
  if (%auto.oper4 == off) { did -c autooper 201 1 %auto.oper4 $did(201) }
  if (%auto.oper4 == off) { did -b $dname 41,71,101 }
  if (%auto.oper4 == on) { did -e $dname 41,71,101 }
  if (%auto.oper5 == on) { did -c autooper 202 1 %auto.oper5 $did(202) }
  if (%auto.oper5 == off) { did -c autooper 203 1 %auto.oper5 $did(203) }
  if (%auto.oper5 == off) { did -b $dname 42,72,102 }
  if (%auto.oper5 == on) { did -e $dname 42,72,102 }
  if (%auto.oper6 == on) { did -c autooper 204 1 %auto.oper6 $did(204) }
  if (%auto.oper6 == off) { did -c autooper 205 1 %auto.oper6 $did(205) }
  if (%auto.oper6 == off) { did -b $dname 43,73,103 }
  if (%auto.oper6 == on) { did -e $dname 43,73,103 }
  if (%auto.oper7 == on) { did -c autooper 206 1 %auto.oper7 $did(206) }
  if (%auto.oper7 == off) { did -c autooper 207 1 %auto.oper7 $did(207) }
  if (%auto.oper7 == off) { did -b $dname 44,74,104 }
  if (%auto.oper7 == on) { did -e $dname 44,74,104 }
  if (%auto.oper8 == on) { did -c autooper 208 1 %auto.oper8 $did(208) }
  if (%auto.oper8 == off) { did -c autooper 209 1 %auto.oper8 $did(209) }
  if (%auto.oper8 == off) { did -b $dname 45,75,105 }
  if (%auto.oper8 == on) { did -e $dname 45,75,105 }
  if (%auto.oper9 == on) { did -c autooper 210 1 %auto.oper9 $did(210) }
  if (%auto.oper9 == off) { did -c autooper 211 1 %auto.oper9 $did(211) }
  if (%auto.oper9 == off) { did -b $dname 46,76,106 }
  if (%auto.oper9 == on) { did -e $dname 46,76,106 }
  if (%auto.oper10 == on) { did -c autooper 212 1 %auto.oper10 $did(212) }
  if (%auto.oper10 == off) { did -c autooper 213 1 %auto.oper10 $did(213) }
  if (%auto.oper10 == off) { did -b $dname 47,77,107 }
  if (%auto.oper10 == on) { did -e $dname 47,77,107 }
} 
on *:dialog:autooper:sclick:*: {
  if ($did == 20) { unset %ircop.serv1 | did -o autooper 1 1 %ircop.serv1 }
  if ($did == 21) { unset %ircop.nick1 | did -o autooper 4 1 %ircop.nick1 }
  if ($did == 22) { unset %ircop.pass1 | did -o autooper 7 1 %ircop.pass1 }
  if ($did == 13) { set %auto.oper1 on | did -e $dname 1,4,7 }
  if ($did == 14) { set %auto.oper1 off | did -b $dname 1,4,7 }
  if ($did == 23) { unset %ircop.serv2 | did -o autooper 2 1 %ircop.serv2 }
  if ($did == 24) { unset %ircop.nick2 | did -o autooper 5 1 %ircop.nick2 }
  if ($did == 25) { unset %ircop.pass2 | did -o autooper 8 1 %ircop.pass2 }
  if ($did == 15) { set %auto.oper2 on | did -e $dname 2,5,8 }
  if ($did == 16) { set %auto.oper2 off | did -b $dname 2,5,8 }
  if ($did == 26) { unset %ircop.serv3 | did -o autooper 3 1 %ircop.serv3 }
  if ($did == 27) { unset %ircop.nick3 | did -o autooper 6 1 %ircop.nick3 }
  if ($did == 28) { unset %ircop.pass3 | did -o autooper 9 1 %ircop.pass3 }
  if ($did == 17) { set %auto.oper3 on | did -e $dname 3,6,9 }
  if ($did == 18) { set %auto.oper3 off | did -b $dname 3,6,9 }
