  if ($did == 19) { set %auto.oper4 on | did -e $dname 41,71,101 }
  if ($did == 201) { set %auto.oper4 off | did -b $dname 41,71,101 }
  if ($did == 32) { unset %ircop.serv5 | did -o autooper 42 1 %ircop.serv5 }
  if ($did == 33) { unset %ircop.nick5 | did -o autooper 72 1 %ircop.nick5 }
  if ($did == 34) { unset %ircop.pass5 | did -o autooper 102 1 %ircop.pass5 }
  if ($did == 202) { set %auto.oper5 on | did -e $dname 42,72,102 }
  if ($did == 203) { set %auto.oper5 off | did -b $dname 42,72,102 }
  if ($did == 35) { unset %ircop.serv6 | did -o autooper 43 1 %ircop.serv6 }
  if ($did == 36) { unset %ircop.nick6 | did -o autooper 73 1 %ircop.nick6 }
  if ($did == 37) { unset %ircop.pass6 | did -o autooper 103 1 %ircop.pass6 }
  if ($did == 204) { set %auto.oper6 on | did -e $dname 43,73,103 }
  if ($did == 205) { set %auto.oper6 off | did -b $dname 43,73,103 }
  if ($did == 50) { unset %ircop.serv7 | did -o autooper 44 1 %ircop.serv7 }
  if ($did == 51) { unset %ircop.nick7 | did -o autooper 74 1 %ircop.nick7 }
  if ($did == 52) { unset %ircop.pass7 | did -o autooper 104 1 %ircop.pass7 }
  if ($did == 206) { set %auto.oper7 on | did -e $dname 44,74,104 }
  if ($did == 207) { set %auto.oper7 off | did -b $dname 44,74,104 }
  if ($did == 53) { unset %ircop.serv8 | did -o autooper 45 1 %ircop.serv8 }
  if ($did == 54) { unset %ircop.nick8 | did -o autooper 75 1 %ircop.nick8 }
  if ($did == 55) { unset %ircop.pass8 | did -o autooper 105 1 %ircop.pass8 }
  if ($did == 208) { set %auto.oper8 on | did -e $dname 45,75,105 }
  if ($did == 209) { set %auto.oper8 off | did -b $dname 45,75,105 }
  if ($did == 56) { unset %ircop.serv9 | did -o autooper 46 1 %ircop.serv9 }
  if ($did == 57) { unset %ircop.nick9 | did -o autooper 76 1 %ircop.nick9 }
  if ($did == 58) { unset %ircop.pass9 | did -o autooper 106 1 %ircop.pass9 }
  if ($did == 210) { set %auto.oper9 on | did -e $dname 46,76,106 }
  if ($did == 211) { set %auto.oper9 off | did -b $dname 46,76,106 }
  if ($did == 59) { unset %ircop.serv10 | did -o autooper 47 1 %ircop.serv10 }
  if ($did == 60) { unset %ircop.nick10 | did -o autooper 77 1 %ircop.nick10 }
  if ($did == 61) { unset %ircop.pass10 | did -o autooper 107 1 %ircop.pass10 }
  if ($did == 212) { set %auto.oper10 on | did -e $dname 47,77,107 }
  if ($did == 213) { set %auto.oper10 off | did -b $dname 47,77,107 }
}
on *:connect: { 
  if (%ircop.nick1 != $null) && (%ircop.pass1 != $null) && ($server == %ircop.serv1) && (%auto.oper1 == on) { /oper %ircop.nick1 %ircop.pass1 }
  if (%con.clock == on) { dialog -m time time } 
  if (%ircop.nick2 != $null) && (%ircop.pass2 != $null) && ($server == %ircop.serv2) && (%auto.oper2 == on) { /oper %ircop.nick2 %ircop.pass2 }
  if (%con.clock == on) { dialog -m time time } 
  if (%ircop.nick3 != $null) && (%ircop.pass3 != $null) && ($server == %ircop.serv3) && (%auto.oper3 == on) { /oper %ircop.nick3 %ircop.pass3 }
  if (%con.clock == on) { dialog -m time time } 
  if (%ircop.nick4 != $null) && (%ircop.pass4 != $null) && ($server == %ircop.serv4) && (%auto.oper4 == on) { /oper %ircop.nick4 %ircop.pass4 }
  if (%con.clock == on) { dialog -m time time } 
  if (%ircop.nick5 != $null) && (%ircop.pass5 != $null) && ($server == %ircop.serv5) && (%auto.oper5 == on) { /oper %ircop.nick5 %ircop.pass5 }
  if (%con.clock == on) { dialog -m time time } 
  if (%ircop.nick6 != $null) && (%ircop.pass6 != $null) && ($server == %ircop.serv6) && (%auto.oper6 == on) { /oper %ircop.nick6 %ircop.pass6 }
  if (%con.clock == on) { dialog -m time time } 
  if (%ircop.nick7 != $null) && (%ircop.pass7 != $null) && ($server == %ircop.serv7) && (%auto.oper7 == on) { /oper %ircop.nick7 %ircop.pass7 }
  if (%con.clock == on) { dialog -m time time } 
  if (%ircop.nick8 != $null) && (%ircop.pass8 != $null) && ($server == %ircop.serv8) && (%auto.oper8 == on) { /oper %ircop.nick8 %ircop.pass8 }
  if (%con.clock == on) { dialog -m time time } 
  if (%ircop.nick9 != $null) && (%ircop.pass9 != $null) && ($server == %ircop.serv9) && (%auto.oper9 == on) { /oper %ircop.nick9 %ircop.pass9 }
  if (%con.clock == on) { dialog -m time time } 
  if (%ircop.nick10 != $null) && (%ircop.pass10 != $null) && ($server == %ircop.serv10) && (%auto.oper10 == on) { /oper %ircop.nick10 %ircop.pass10 }
  if (%con.clock == on) { dialog -m time time } 
  if (%auto-todo1 != $null) { %auto-todo1 }
  if (%auto-todo2 != $null) { %auto-todo2 }
  if (%auto-todo3 != $null) { %auto-todo3 }
  if (%auto-todo4 != $null) { %auto-todo4 }
}
menu status,menubar {
  -
  -= Auto-Oper =-:dialog -m autooper autooper
} 
