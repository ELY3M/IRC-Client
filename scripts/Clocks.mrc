on *:DIALOG:Time:*:*:{
  if ($devent == INIT) {
    did -ra time 6 $gmtoff(+8)
    did -ra time 8 $gmtoff(+1)
    did -ra time 4 $gmtoff(-6)
    did -ra time 10 $gmtoff(-10)
    did -ra time 12 $gmtoff(+8)
    did -ra time 14 $gmtoff(+0)
    did -ra time 16 $gmtoff(+2)
    did -ra time 18 $gmtoff(-10)
    did -ra time 20 $gmtoff(+4.5)
    did -ra time 22 $gmtoff(+5.5)
    did -ra time 24 $gmtoff(+5)
    did -ra time 26 $gmtoff(+0)
    did -ra time 28 $gmtoff(+10)
    did -ra time 30 $gmtoff(+3)
    did -ra time 32 $gmtoff(+10)
    did -ra time 34 $gmtoff(+12)
    did -ra time 36 $gmtoff(+9)
    did -ra time 38 $gmtoff(-3)
    did -ra time 40 $gmtoff(-3.5)
    did -ra time 42 $gmtoff(-7)
    did -ra time 44 $gmtoff(+2)
    did -ra time 46 $gmtoff(-4)
    did -ra time 50 $gmtoff(+2)
    did -ra time 52 $gmtoff(+9.5)
    did -ra time 56 $gmtoff(+7)
    did -ra time 54 $gmtoff(+13)
  }
}
